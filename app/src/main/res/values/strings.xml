<resources>
    <string name="app_name">SnapCrop</string>
    <string name="accessibility_service_name">SnapCrop Screen Capture</string>
    <string name="accessibility_service_description">Enables the screen edge bar and instant button triggers to capture and crop your screen seamlessly.</string>
    
    <!-- Header & Status -->
    <string name="hero_badge">Instant Screen Capture &amp; AI</string>
    <string name="hero_title">Snap, Crop &amp; Share</string>
    <string name="hero_subtitle">Crop anything on your screen in seconds and send it straight to Gemini, copy to clipboard, save, or share with friends.</string>
    
    <string name="status_ready_title">SnapCrop is Ready</string>
    <string name="status_ready_desc">The side bar and 3-tap volume trigger are active on your screen.</string>
    <string name="status_setup_needed_title">Setup Required</string>
    <string name="status_setup_needed_desc">Enable permissions below so SnapCrop can capture and crop your screen.</string>
    
    <!-- How to capture -->
    <string name="section_how_to_capture">Triggers</string>
    <string name="trigger_slider_title">1. Screen Edge Bar</string>
    <string name="trigger_slider_desc">Tap or swipe the subtle bar docked at the edge of your screen anytime.</string>
    <string name="trigger_volume_title">2. Tap Volume Up 3 Times</string>
    <string name="trigger_volume_desc">Rapidly click your physical Volume Up button 3 times to capture instantly.</string>
    
    <!-- Actions -->
    <string name="section_what_you_can_do">What You Can Do</string>
    <string name="feature_ocr_title">Select Text (OCR)</string>
    <string name="feature_ocr_desc">Instantly recognize text from your screen selection, copy it, or search Google.</string>
    <string name="feature_gemini_title">Ask Gemini AI</string>
    <string name="feature_gemini_desc">Explain, summarize, translate, or solve anything you crop with one tap.</string>
    <string name="feature_share_title">Quick Share</string>
    <string name="feature_share_desc">Send your cropped image with an instant preview directly to any app.</string>
    <string name="feature_copy_save_title">Copy &amp; Save</string>
    <string name="feature_copy_save_desc">Copy the image to your clipboard or save it to your photo gallery.</string>
    
    <!-- Setup Steps -->
    <string name="section_permissions">Setup &amp; Permissions</string>
    <string name="step_accessibility_title">Screen Capture Permission</string>
    <string name="step_accessibility_desc">Allows the floating edge bar and silent screen capture.</string>
    <string name="btn_open_accessibility">Enable in Settings</string>
    <string name="step_battery_title">Keep Active in Background</string>
    <string name="step_battery_desc">Allows SnapCrop to stay responsive even when your phone is asleep.</string>
    <string name="btn_battery_optimization">Allow Background Use</string>
    
